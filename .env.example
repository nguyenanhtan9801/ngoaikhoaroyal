# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# SUPABASE INTEGRATION (PostgreSQL, Realtime WebSockets & Storage Bucket):
SUPABASE_URL="https://deuuzrjpfcabfclwaqph.supabase.co"
VITE_SUPABASE_URL="https://deuuzrjpfcabfclwaqph.supabase.co"
SUPABASE_PUBLISHABLE_KEY="sb_publishable_SHwnK37LokxsP9zVNFSf9Q_qCMxjlat"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_SHwnK37LokxsP9zVNFSf9Q_qCMxjlat"
VITE_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImRldXV6cmpwZmNhYmZjbHdhcXBoIiwicm9sZSI6ImFub24iLCJpYXQiOjE3OTM2NDg3NzIsImV4cCI6MjEwOTIyNDc3Mn0.s6HjYT0Zd3mZueH-OP2UHQhp_sMy-X8qH3bgp8PuOT8"
SUPABASE_JWKS_URL="https://deuuzrjpfcabfclwaqph.supabase.co/auth/v1/.well-known/jwks.json"

# VITE_LEGACY_LOGIN: Cờ giữ đăng nhập cũ làm phương án lùi. Đặt 'false' để chỉ dùng Supabase Auth:
VITE_LEGACY_LOGIN="false"

# SUPABASE_SECRET_KEY / SUPABASE_SERVICE_ROLE_KEY: Chỉ dùng ở phía server (server.ts) cho các endpoint quản trị (/api/admin/*) và cổng phụ huynh.
# TUYỆT ĐỐI KHÔNG đưa vào biến VITE_*:
SUPABASE_SECRET_KEY="YOUR_SUPABASE_SECRET_KEY"
SUPABASE_SERVICE_ROLE_KEY="YOUR_SUPABASE_SERVICE_ROLE_KEY"

# PARENT_SESSION_SECRET: Khóa bí mật ký HMAC-SHA256 cho phiên tra cứu của phụ huynh (chỉ dùng ở phía server).
# Sinh khóa bằng lệnh: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
PARENT_SESSION_SECRET="YOUR_PARENT_SESSION_SECRET"


