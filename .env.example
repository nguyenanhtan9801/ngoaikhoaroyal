# ============================================================================
# 1. BIẾN LÚC BUILD (BUILD-TIME VARIABLES)
# ============================================================================
# Các biến này được Vite nhúng trực tiếp vào gói giao diện tĩnh (dist/) khi chạy
# `npm run build`. Nếu thay đổi bất kỳ biến nào trong nhóm này, BẮT BUỘC phải
# chạy lại quá trình build (build lại Docker image / redeploy từ source).
# TUYỆT ĐỐI KHÔNG đặt khóa bí mật (service_role, secret) vào biến bắt đầu bằng VITE_*.

VITE_SUPABASE_URL="https://deuuzrjpfcabfclwaqph.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_SHwnK37LokxsP9zVNFSf9Q_qCMxjlat"
VITE_SUPABASE_ANON_KEY=""
VITE_LEGACY_LOGIN="false"
APP_BUILD_ID=""

# ============================================================================
# 2. BIẾN LÚC CHẠY (RUNTIME VARIABLES — CHỈ DÙNG TRÊN MÁY CHỦ EXPRESS server.ts)
# ============================================================================
# Các biến này được đọc trực tiếp từ `process.env` khi máy chủ khởi động (`npm start`).
# Khi thay đổi chỉ cần cập nhật biến môi trường / Secret Manager và khởi động lại
# container mà không cần build lại mã nguồn giao diện.
# ĐỂ TRỐNG GIÁ TRỊ BÍ MẬT TRONG FILE MẪU NÀY.

NODE_ENV="production"
PORT="8080"

# Địa chỉ Supabase cho máy chủ Express (mặc định dùng cùng project với VITE_SUPABASE_URL)
SUPABASE_URL="https://deuuzrjpfcabfclwaqph.supabase.co"
SUPABASE_PUBLISHABLE_KEY="sb_publishable_SHwnK37LokxsP9zVNFSf9Q_qCMxjlat"
SUPABASE_ANON_KEY=""
SUPABASE_JWKS_URL="https://deuuzrjpfcabfclwaqph.supabase.co/auth/v1/.well-known/jwks.json"

# Khóa quản trị Supabase (BẮT BUỘC để tạo/sửa/xóa tài khoản, check-in QR, cổng phụ huynh, upload minh chứng)
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_SECRET_KEY=""

# Khóa bí mật ký HMAC-SHA256 cho phiên tra cứu của Cổng Phụ Huynh (chuỗi ngẫu nhiên >= 32 ký tự)
PARENT_SESSION_SECRET=""

# Khóa bí mật ký HMAC-SHA256 cho mã QR check-in giáo viên (chuỗi ngẫu nhiên >= 32 byte)
CHECKIN_QR_SECRET=""
CHECKIN_QR_TTL_SECONDS="90"
CHECKIN_LATE_GRACE_MIN="5"

# Khóa API Gemini (phục vụ trợ lý nghiệp vụ tại /api/chat và /api/ai-analyze)
GEMINI_API_KEY=""

# Địa chỉ URL chính thức của ứng dụng khi phát hành
APP_URL=""
