# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# SUPABASE INTEGRATION (PostgreSQL, Realtime WebSockets & Storage Bucket):
# Hỗ trợ cả định dạng khóa mới (sb_publishable_..., sb_secret_...) và chuẩn JWT cũ (eyJ...):
VITE_SUPABASE_URL="https://deuuzrjpfcabfclwaqph.supabase.co"
SUPABASE_URL="https://deuuzrjpfcabfclwaqph.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_SHwnK37LokxsP9zVNFSf9Q_qCMxjlat"
VITE_SUPABASE_ANON_KEY=""
SUPABASE_ANON_KEY=""
SUPABASE_JWKS_URL="https://deuuzrjpfcabfclwaqph.supabase.co/auth/v1/.well-known/jwks.json"

# VITE_LEGACY_LOGIN: Cờ giữ đăng nhập cũ làm phương án lùi. Đặt 'false' để chỉ dùng Supabase Auth:
VITE_LEGACY_LOGIN="false"

# SUPABASE_SERVICE_ROLE_KEY / SUPABASE_SECRET_KEY: Chỉ dùng ở phía server (server.ts) cho các endpoint quản trị (/api/admin/*) và cổng phụ huynh.
# TUYỆT ĐỐI KHÔNG đưa vào biến VITE_*:
SUPABASE_SERVICE_ROLE_KEY="YOUR_SUPABASE_SERVICE_ROLE_KEY"
SUPABASE_SECRET_KEY="YOUR_SUPABASE_SECRET_KEY"

# PARENT_SESSION_SECRET: Khóa bí mật ký HMAC-SHA256 cho phiên tra cứu của phụ huynh (chỉ dùng ở phía server):
PARENT_SESSION_SECRET="YOUR_PARENT_SESSION_SECRET"

# CHECKIN_QR_SECRET: Khóa bí mật (>= 32 byte) ký HMAC-SHA256 cho mã QR check-in giáo viên (chỉ dùng ở phía server):
CHECKIN_QR_SECRET=""
CHECKIN_QR_TTL_SECONDS="90"
CHECKIN_LATE_GRACE_MIN="5"
