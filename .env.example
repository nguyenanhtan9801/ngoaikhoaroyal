# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# SUPABASE INTEGRATION (PostgreSQL, Realtime WebSockets & Storage Bucket):
VITE_SUPABASE_URL="https://wobszxqzlalzcjcfbzhq.supabase.co"
VITE_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6IndvYnN6eHF6bGFsemNqY2ZiemhxIiwicm9sZSI6ImFub24iLCJpYXQiOjE3OTI0Nzg3MDQsImV4cCI6MjEwODA1NDcwNH0.fACSgo3mpzdBS-of_fFkMF14NYL3J3P_5WM2k6FtEcA"

# VITE_LEGACY_LOGIN: Cờ giữ đăng nhập cũ làm phương án lùi (mặc định 'true'). Đặt 'false' để chỉ dùng Supabase Auth:
VITE_LEGACY_LOGIN="true"

# SUPABASE_SERVICE_ROLE_KEY: Chỉ dùng ở phía server (server.ts) cho các endpoint quản trị (/api/admin/*).
# TUYỆT ĐỐI KHÔNG đưa vào biến VITE_*:
SUPABASE_SERVICE_ROLE_KEY="YOUR_SUPABASE_SERVICE_ROLE_KEY"

